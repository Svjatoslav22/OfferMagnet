# --- РЎРїС–Р»СЊРЅС– (Vercel + Railway) ---
# Neon: DIRECT-СЂСЏРґРѕРє (Р±РµР· -pooler) вЂ” РґР»СЏ prisma migrate / db push
DATABASE_URL=postgresql://user:password@host/offermagnet?sslmode=require
# Neon: POOLED-СЂСЏРґРѕРє (Р· -pooler Сѓ С…РѕСЃС‚С–) вЂ” РґР»СЏ СЂР°РЅС‚Р°Р№РјСѓ (Vercel С– РІРѕСЂРєРµСЂ). РќРµРѕР±РѕРІ'СЏР·РєРѕРІРѕ Р»РѕРєР°Р»СЊРЅРѕ.
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/offermagnet?sslmode=require

# --- Railway worker (Р±РѕС‚ + CRON + РѕР±СЂРѕР±РЅРёРє С‡РµСЂРіРё) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TELEGRAM_BOT_TOKEN=
# Р’Р°С€ Telegram ID вЂ” Р»РёС€Рµ РІРё РјРѕР¶РµС‚Рµ Р·Р°РІР°РЅС‚Р°Р¶СѓРІР°С‚Рё CV/cookies С‡РµСЂРµР· Р±РѕС‚Р°
OWNER_TELEGRAM_ID=
CRON_SCHEDULE=0 9 * * *
JOB_POLL_MS=3000

# РЁР»СЏС…Рё РЅР° Railway Volume (mount path: /data). РЈ Dockerfile РІР¶Рµ Р·Р°РґР°РЅС–.
COOKIES_DIR=/data/cookies
CV_PATH=/data/Sviatoslav_Tumtciv_CV.pdf
ARTIFACTS_DIR=/data/artifacts/applies
CHROMIUM_PATH=/usr/bin/chromium

# Курс USD/UAH для порівняння зарплат (за замовчуванням 41)
USD_UAH_RATE=41

# Запуск одного циклу пошуку одразу при старті бота (true за замовчуванням, false вимикає)
RUN_ON_START=true
