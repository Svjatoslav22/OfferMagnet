# --- Спільні (Vercel + Railway) ---
# Neon: використовуйте рядок підключення (з ?sslmode=require)
DATABASE_URL=postgresql://user:password@host/offermagnet?sslmode=require

# --- Railway worker (бот + CRON + обробник черги) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID — лише ви можете завантажувати CV/cookies через бота
OWNER_TELEGRAM_ID=
CRON_SCHEDULE=0 9 * * *
JOB_POLL_MS=3000

# Шляхи на Railway Volume (mount path: /data). У Dockerfile вже задані.
COOKIES_DIR=/data/cookies
CV_PATH=/data/Sviatoslav_Tumtciv_CV.pdf
ARTIFACTS_DIR=/data/artifacts/applies
CHROMIUM_PATH=/usr/bin/chromium
